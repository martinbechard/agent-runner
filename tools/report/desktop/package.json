{
  "name": "agent-report-desktop",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "build:sidecar": "node scripts/build-renderer-sidecar.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri:dev": "tauri dev --config src-tauri/tauri.sidecar.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.sidecar.conf.json && bash scripts/fix-dmg-hidden-files.sh ../target/release/bundle/dmg",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
